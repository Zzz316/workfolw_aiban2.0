{
  "db": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "root",
    "password": "root",
    "charset": "GB2312",
    "alarm_table": "icamera_data.icam_alarm_data"
  },
  "socket_server": {
    "host": "127.0.0.1",
    "port": 10000,
    "encoding": "gbk"
  },
  "api_server": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 18080,
    "max_body_bytes": 10488
  },
  "api_triggers": [
    {
      "id": "printer_complete",
      "name": "API触发器",
      "enabled": true,
      "method": "POST",
      "path": "/aiban/api-trigger/printer_complete",
      "auth": {
        "type": "none"
      },
      "request": {
        "content_type": "json",
        "sourceid_path": "body.sourceid",
        "target_step_id_path": "",
        "payload_mappings": {
          "printJobId": "body.printJobId",
          "printerName": "body.printerName",
          "printTimestamp": "body.printTimestamp"
        }
      },
      "event": {
        "type": "step_hit",
        "target_step_id": "step2",
        "ttl_seconds": 5,
        "count": 1
      },
      "response": {
        "status": 200,
        "body": {
          "status": "200",
          "errmsg": ""
        }
      },
      "sourceid": 1,
      "group_id": 1
    }
  ],
  "workflows": [
    {
      "name": "步骤顺序检测",
      "mode": "sequence",
      "group_id": 1,
      "model_id": 1,
      "timers": {
        "step_timeout": {
          "timeout": 999999
        }
      },
      "sequence": {
        "ordered": true,
        "timeout_timer": "step_timeout",
        "steps": [
          {
            "id": "step1",
            "label": "bin",
            "confidence": 0.5
          },
          {
            "id": "step2",
            "label": "step2",
            "confidence": 0,
            "external": true,
            "trigger": false
          },
          {
            "id": "step3",
            "label": "label",
            "confidence": 0.5
          },
          {
            "id": "step4",
            "label": "desk",
            "confidence": 0.8,
            "end": true
          }
        ],
        "on_complete": [
          {
            "log": "流程完成：bin → step2 → label → desk，OK"
          },
          {
            "save_db": {
              "table": "icamera_data.icam_alarm_data",
              "fields": {
                "day": "$date",
                "time": "$time",
                "time_division": "$time_division",
                "time_month": "$time_month",
                "week": "$week",
                "region": "$region",
                "group_id": 1,
                "camera_id": "$sourceid",
                "alarm_content": "流程OK",
                "img_path": "$image_path",
                "timedate": "$datetime",
                "alarm_status": "OK"
              }
            }
          }
        ],
        "on_incomplete": [
          {
            "alarm_each_missing": {
              "type": "ng",
              "save_image": true,
              "cooldown": 10
            }
          }
        ],
        "on_skip": [
          {
            "alarm": {
              "msg": "漏步骤:{skipped_step}",
              "type": "ng",
              "save_image": true,
              "cooldown": 10
            }
          }
        ],
        "on_wrong_count": [
          {
            "alarm": {
              "msg": "{step_alarm_name} (数量错误，期望:{expected_count} 实际:{actual_count})",
              "type": "ng",
              "save_image": true,
              "cooldown": 10
            }
          }
        ],
        "on_timeout": [
          {
            "alarm": {
              "msg": "步骤超时",
              "type": "ng",
              "save_image": true,
              "cooldown": 10
            }
          }
        ]
      }
    }
  ]
}