# AiBan Workflow 2.0 — Phase 2: MySQL Database Configuration
#
# Copy this file to workflow_db.env and fill in your values.
# The workflow_db.env file MUST NOT be committed to git.
#
# These environment variables are read by lib/mysql-write-queue.js
# and aiban-result-db node.

# MySQL host (default: 127.0.0.1)
MYSQL_HOST=127.0.0.1

# MySQL port (default: 3306)
MYSQL_PORT=3306

# MySQL user (default: root)
MYSQL_USER=root

# MySQL password
MYSQL_PASSWD=

# MySQL database name (default: icamera_data)
MYSQL_DB=icamera_data

# Connection pool size (default: 5)
AIBAN_DB_POOL_SIZE=5

# Max write retry attempts (default: 3)
AIBAN_DB_MAX_RETRIES=3

# Retry delay in ms, doubled on each attempt (default: 500)
AIBAN_DB_RETRY_DELAY_MS=500

# Max pending writes in queue before overflow to failure file (default: 1000)
AIBAN_DB_QUEUE_SIZE=1000
