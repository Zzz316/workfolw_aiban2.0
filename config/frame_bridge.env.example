# Enable Workflow 2.0 delivery. Keep disabled until Node-RED zeromq is installed.
AIBAN_V2_BRIDGE_ENABLED=0

# Keep the 1.0 engine enabled during shadow comparison.
AIBAN_V1_ENGINE_ENABLED=1

AIBAN_FRAME_ENDPOINT=tcp://127.0.0.1:5557
AIBAN_FRAME_OUTBOX=data/frame_bridge/outbox.db
AIBAN_FRAME_HIGH_WATERMARK=5000
AIBAN_FRAME_LOW_WATERMARK=1000
AIBAN_FRAME_RETRY_SECONDS=1.0
AIBAN_FRAME_BATCH_SIZE=100
AIBAN_FRAME_LOG_EVERY=1
AIBAN_FRAME_CONSOLE_LATENCY=1

# Disk emergency: pause all sources when the filesystem containing the outbox
# reaches this usage percentage.
AIBAN_FRAME_DISK_EMERGENCY_PERCENT=95

# Screenshot request timeout in seconds.
AIBAN_FRAME_SCREENSHOT_TIMEOUT=30.0

# Stats JSON file path (written by videowork subprocess, read by Flask).
AIBAN_FRAME_STATS_FILE=data/frame_bridge/stats.json

# Business database (not used for the transport outbox/inbox).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWD=root
MYSQL_DB=icamera_data
