{
  "name": "node-red-contrib-aiban-workflow",
  "version": "1.3.0",
  "description": "Node-RED nodes for Aiban Workflow Engine — Phase 2 Topology-Driven Runtime",
  "main": "aiban-runtime.js",
  "scripts": {
    "test": "node --test test/*.test.js --test-concurrency=1",
    "test:phase1": "node --test test/aiban-runtime.test.js --test-concurrency=1",
    "test:phase2": "node --test test/phase2-closed-loop.test.js",
    "test:real-sdk": "node --test test/aiban-real-sdk.test.js --test-concurrency=1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "node-red",
    "aiban",
    "workflow"
  ],
  "node-red": {
    "nodes": {
      "aiban-runtime": "aiban-runtime.js",
      "aiban-scene-control": "aiban-scene-control.js",
      "aiban-scene-router": "aiban-scene-router.js",
      "aiban-scene-entry": "aiban-scene-entry.js",
      "aiban-label": "aiban-label.js",
      "aiban-result": "aiban-result.js",
      "aiban-result-db": "aiban-result-db.js",
      "aiban-api-trigger": "aiban-api-trigger.js",
      "aiban-api-output": "aiban-api-output.js",
      "aiban-socket-output": "aiban-socket-output.js",
      "aiban-sequence-logic": "aiban-sequence-logic.js",
      "aiban-monitor-logic": "aiban-monitor-logic.js",
      "aiban-timer-record": "aiban-timer-record.js",
      "aiban-custom-flow": "aiban-custom-flow.js"
    }
  },
  "dependencies": {
    "js-yaml": "^4.3.1",
    "mysql2": "^3.22.5"
  },
  "author": "Your Name",
  "license": "MIT"
}
