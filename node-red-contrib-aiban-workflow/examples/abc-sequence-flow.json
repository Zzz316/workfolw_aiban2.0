                "v": "{\"type\":\"frame\",\"schema_version\":1,\"message_id\":\"test-b-1\",\"session_id\":\"test-session\",\"stream_id\":\"group-1/source-1\",\"frame_seq\":101,\"group_id\":1,\"source_id\":1,\"models\":{\"1\":{\"ok\":true,\"boxes\":[{\"label\":\"B\",\"label_index\":0,\"confidence\":0.9}]}},\"labels\":[{\"model_id\":\"1\",\"label\":\"B\",\"confidence\":0.9}],\"label_summary\":\"m1:B(0.900)\"}",
                "vt": "json"
